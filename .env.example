# ==============================================================================
# Smart Energy Consumption Analytics - Environment Configuration Template
# ==============================================================================
# HOW TO USE:
#   1. Copy this file to .env:       cp .env.example .env
#   2. Replace placeholder values with your actual configuration.
#   3. NEVER commit the .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft Mode, no Zookeeper)
# ------------------------------------------------------------------------------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9094
KAFKA_TOPIC=smart_energy
KAFKA_DEFAULT_PARTITIONS=4
KAFKA_REPLICATION_FACTOR=1

# Kafka UI
KAFKA_UI_PORT=8080
KAFKA_CLUSTER_NAME=local

# ------------------------------------------------------------------------------
# Producer Configuration
# ------------------------------------------------------------------------------
# Path to the local dataset directory (mapped into the producer container)
DATA_PATH=./data

# Producer tuning
PRODUCER_BATCH_SIZE=10000
PRODUCER_BATCH_DELAY_SECONDS=0.0

# MAX_ROWS=0 means stream the FULL dataset (no limit).
# Set to a positive integer (e.g. 10000) to limit rows for testing only.
MAX_ROWS=0

# Start reading the CSV after N rows (0 = from beginning)
START_AFTER=0

# ------------------------------------------------------------------------------
# Apache Spark (4.0.1, Java 21, Scala 2.13)
# ------------------------------------------------------------------------------
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8090
SPARK_WORKER_UI_PORT=8091
SPARK_HISTORY_UI_PORT=18080
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# ------------------------------------------------------------------------------
# ClickHouse Columnar OLAP Database
# ------------------------------------------------------------------------------
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
# Change this to a strong password in production
CLICKHOUSE_PASSWORD=change_me

# ------------------------------------------------------------------------------
# Apache Airflow (2.9.2, CeleryExecutor)
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PORT=8088
AIRFLOW_ADMIN_USERNAME=admin
# Change this to a strong password in production
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_with_fernet

# Random secret key for Airflow webserver session signing
AIRFLOW_SECRET_KEY=change_me_random_secret_key

# Celery Flower UI
FLOWER_PORT=5555

# ------------------------------------------------------------------------------
# PostgreSQL - Airflow Metadata Database
# ------------------------------------------------------------------------------
POSTGRES_DB=airflow
POSTGRES_USER=airflow
# Change this to a strong password in production
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis - Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_PORT=6379
# Leave empty for no password (Docker internal network only), or set a password
REDIS_PASSWORD=
